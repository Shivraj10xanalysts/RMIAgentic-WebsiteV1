# Copy to .env.local (or set as real environment variables on the server).
# SMTP account used to send the contact-form emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@rmiagentic.com
SMTP_PASS=change-me
# Sender shown on the emails (defaults to SMTP_USER)
MAIL_FROM="RMI Agentic Website <no-reply@rmiagentic.com>"
# Comma-separated recipients (defaults to the two addresses below)
CONTACT_TO=tank@rmiagentic.com,shivraj@10xanalysts.com
